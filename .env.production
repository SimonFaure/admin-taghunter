# Production build env — auto-loaded by `vite build` (mode=production), overrides .env.
#
# Both the frontend and the /media + /backend paths are served from the SAME origin
# in prod, so these MUST be relative. Leaving VITE_MEDIA_BASE_URL empty makes media
# URLs root-relative (/media/<uniqid>/file.png), so they inherit the page's origin and
# protocol (https). Hardcoding a host here is what caused dev-host URLs + ERR_SSL_PROTOCOL_ERROR.
VITE_API_BASE_URL=/backend/api
VITE_MEDIA_BASE_URL=
