RewriteEngine On
RewriteBase /backend/

# Forward the Authorization header to PHP. Apache strips it from the CGI
# environment by default; without this rule $_SERVER['HTTP_AUTHORIZATION']
# is always empty and bearer-token endpoints reject every request as 401.
RewriteCond %{HTTP:Authorization} ^(.+)
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Set CORS headers for all requests
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "POST, GET, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Requested-With"
Header always set Access-Control-Max-Age "3600"

# Handle CORS preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Deny access to config and database directories
RewriteRule ^(config|database)/ - [F,L]

# Raise upload limits for large media POSTs (game-type tutorial videos,
# scenario imports). This block ONLY applies on legacy mod_php hosts; on
# CGI/FastCGI/FPM hosts these directives are ignored and backend/.user.ini
# takes effect instead. Wrapped in <IfModule> so a FastCGI host doesn't 500.
<IfModule mod_php7.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value memory_limit 512M
    php_value max_execution_time 600
    php_value max_input_time 600
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value memory_limit 512M
    php_value max_execution_time 600
    php_value max_input_time 600
</IfModule>
